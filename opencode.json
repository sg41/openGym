{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "context7": {
            "type": "remote",
            "url": "https://mcp.context7.com/mcp",
            "headers": {
                "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
            }
        },
        "serena": {
            "type": "local",
            "command": [
                "uvx",
                "--from",
                "git+https://github.com/oraios/serena",
                "serena",
                "start-mcp-server"
            ]
        },
        "sequential-thinking": {
            "type": "local",
            "command": [
                "docker",
                "run",
                "--rm",
                "-i",
                "mcp/sequentialthinking"
            ]
        },
        "opengym": {
            "type": "local",
            "command": [
                "node",
                "/home/serge/opengym/mcp/src/index.js"
            ],
            "environment": {
                "OPENGYM_DATA": "/home/serge/opengym/data",
                "OPENGYM_UID": "ygurXGuvcyWHwpO9"
            }
        }
    }
}